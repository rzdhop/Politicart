{
  "name": "politicart",
  "version": "0.0.0",
  "private": true,
  "description": "Politikar: a satirical 3D kart racer, and the design system extracted from it",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "serve": "npm run build -w @politikar/ui && npm run build -w @politikar/game && npm start -w @politikar/server"
  },
  "devDependencies": {
    "@neon/config": "1.9.5",
    "@neon/env": "1.6.6",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.5"
  }
}
