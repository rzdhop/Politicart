# Local settings for the game server. Copy to .env (never committed):
# `npm start -w @kart-republique/server` reads it; variables already set in
# the environment win. On a host, set these as secrets instead.

# The administrator's account name. Reserved: nobody else can sign up under it.
KR_ADMIN_USER=rida

# Its password hash, from `npm run -s admin-hash -w @kart-republique/server`.
# Keep the single quotes: the hash contains `$`. Left empty, nobody is admin.
KR_ADMIN_PASSWORD_HASH='scrypt$<32-hex-salt>$<128-hex-key>'

# Where accounts live: a Postgres URL, or else a JSON file (empty: the default
# apps/server/data/kr-accounts.json; ':memory:' keeps nothing). A relative
# KR_DATA path is relative to apps/server, where npm starts the server.
DATABASE_URL=
KR_DATA=
