# Kart République game server: local settings.
#
# Copy this file to `.env` at the repo root and fill it in. `.env` is git-
# ignored: never commit it. `npm start -w @kart-republique/server` loads it
# with `node --env-file-if-exists`; a variable already set in the shell wins.
# On Fly.io, use `fly secrets set` instead (see the hash below).

# Port and interface to listen on.
# PORT=8080
# HOST=0.0.0.0

# The admin account's name.
KR_ADMIN_USER=rida

# The scrypt hash of the admin password -- never the password itself. Make it
# with (asks twice, nothing is echoed; -s keeps npm's banner out of the output):
#   npm run -s admin-hash -w @kart-republique/server
# Left empty, the admin endpoints are disabled and answer 503.
#
# The hash contains `$` signs. Node reads this file literally, so the value
# works quoted or not; wrap it in single quotes anyway, so the line stays
# correct if a shell ever sources the file. Use single quotes on a command
# line too, or the shell eats the `$N`:
#   fly secrets set KR_ADMIN_PASSWORD_HASH='scrypt$N=16384,r=8,p=1$...$...'
KR_ADMIN_PASSWORD_HASH=''

# Where the admin's cast edits are kept (roster.json): names, colours,
# liveries, posters. Created if missing. Defaults to apps/server/data, which
# git ignores; the Docker image and fly.toml use /data (a volume on Fly). A
# relative path is read from the server's working directory, apps/server.
# KR_DATA_DIR=/var/lib/kart-republique

# 1 only when the server runs behind Fly.io's proxy (fly.toml sets it): the
# client IP is then read from Fly-Client-IP and the scheme from
# X-Forwarded-Proto. Anywhere else keep 0, or any client could forge both.
KR_TRUST_PROXY=0
